# --- RoadGuard Atlas ML pipeline (run from ml/ or via `make -C ml <target>`) ---
# Python interpreter / package dir
PYTHON      ?= python3
PIP         ?= $(PYTHON) -m pip

# Dataset / model knobs
DATA        ?= dataset/road_hazards.yaml          # canonical schema (real data)
DEMO_DATA   ?= dataset/road_hazards.demo.yaml     # generated by `make demo-data`
MODEL       ?= yolov8s.pt                          # demo target overrides to yolov8n.pt
EPOCHS      ?= 50
IMGSZ       ?= 640
BATCH       ?= 16
DEVICE      ?= cpu                                  # cpu | 0 | 0,1 | mps
SEED        ?= 42
WORKERS     ?= 2
CONF        ?= 0.25
IOU         ?= 0.45

# Serving
PORT        ?= 8000
MLFLOW_PORT ?= 5000
MLRUNS      ?= $(shell pwd)/mlruns

# Export
ONNX_OUT    ?= models/roadguard.onnx

.PHONY: help setup demo demo-data validate split train evaluate export serve \
        mlflow-ui test class-balance augment-preview clean

help:
        @echo "RoadGuard Atlas ML pipeline"
        @echo "  make setup          - install python deps (CPU torch)"
        @echo "  make demo-data      - generate tiny synthetic dataset + yaml"
        @echo "  make demo           - full pipeline: demo-data, split, validate, train(3 ep), evaluate, export"
        @echo "  make validate [DATA=..]          - validate dataset, write reports/validate_report.json"
        @echo "  make split       [DATA_ROOT=..] - stratified 70/20/10 split (SEED)"
        @echo "  make train       [EPOCHS=.. IMGSZ=.. BATCH=.. DEVICE=.. MODEL=.. DATA=..]"
        @echo "  make evaluate    [DATA=..]      - test-split metrics + latency -> reports/metrics.json"
        @echo "  make export      [MODEL=..]     - export ONNX + parity check vs PyTorch"
        @echo "  make serve       [PORT=..]      - uvicorn inference_service (FastAPI)"
        @echo "  make mlflow-ui   [MLFLOW_PORT=..] - MLflow UI over ./mlruns"
        @echo "  make test                       - pytest ml/tests"

setup:
        $(PIP) install torch torchvision --index-url https://download.pytorch.org/whl/cpu
        $(PIP) install -r requirements.txt

# ---------------------------------------------------------------------------
# Dataset pipeline
# ---------------------------------------------------------------------------
demo-data:
        $(PYTHON) scripts/make_demo_data.py --out datasets/demo --num 240 --size 416 --seed $(SEED)
        $(PYTHON) scripts/split_dataset.py --dataset-root datasets/demo --ratios 0.7 0.2 0.1 --seed $(SEED)
        $(PYTHON) scripts/validate_dataset.py --dataset-root datasets/demo --report reports/validate_report.json

split:
        $(PYTHON) scripts/split_dataset.py --dataset-root $(or $(DATA_ROOT),datasets/road_hazards) \
                --ratios 0.7 0.2 0.1 --seed $(SEED)

validate:
        $(PYTHON) scripts/validate_dataset.py --dataset-root $(or $(DATA_ROOT),datasets/road_hazards) \
                --report reports/validate_report.json

class-balance:
        $(PYTHON) scripts/class_balance.py --dataset-root $(or $(DATA_ROOT),datasets/road_hazards)

augment-preview:
        $(PYTHON) scripts/augment_preview.py --data $(DEMO_DATA) --out reports/augment_preview.png --grid 9

# ---------------------------------------------------------------------------
# Train / evaluate / export / serve
# ---------------------------------------------------------------------------
train:
        $(PYTHON) train.py --data $(DATA) --model $(MODEL) --epochs $(EPOCHS) \
                --imgsz $(IMGSZ) --batch $(BATCH) --device $(DEVICE) --workers $(WORKERS) --seed $(SEED)

evaluate:
        $(PYTHON) evaluate.py --data $(DATA) --split test --imgsz $(IMGSZ) --device $(DEVICE) \
                --conf $(CONF) --iou $(IOU) --report reports/metrics.json

export:
        $(PYTHON) export_onnx.py --weights models/best.pt --imgsz $(IMGSZ) --out $(ONNX_OUT)

serve:
        $(PYTHON) inference_service.py --host 0.0.0.0 --port $(PORT)

mlflow-ui:
        MLFLOW_TRACKING_URI=sqlite:///$(shell pwd)/mlflow.db $(PYTHON) -m mlflow ui \
                --backend-store-uri sqlite:///$(shell pwd)/mlflow.db \
                --default-artifact-root file://$(MLRUNS) \
                --port $(MLFLOW_PORT) --host 0.0.0.0

test:
        $(PYTHON) -m pytest tests -v

# End-to-end demo on tiny synthetic data (CPU, a few minutes):
demo: demo-data
        $(PYTHON) train.py --data $(DEMO_DATA) --model yolov8n.pt --epochs 3 --imgsz 416 \
                --batch 8 --device cpu --workers 2 --seed 42 --run-name demo
        $(PYTHON) evaluate.py --data $(DEMO_DATA) --weights runs/demo*/weights/best.pt --split test \
                --imgsz 416 --device cpu --report reports/metrics.json
        $(PYTHON) export_onnx.py --weights runs/demo*/weights/best.pt --imgsz 416 \
                --out models/roadguard-demo.onnx

clean:
        rm -rf runs/* mlruns/* reports/* models/*.onnx
