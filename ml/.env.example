# RoadGuard Atlas ML — environment variables (copy to ../.env or export in shell)
# All optional; sensible defaults are used by ml/train.py, evaluate.py and the service.

# MLflow tracking backend. Default: file://<ml>/mlruns
# For the docker-compose stack use the mlflow service URI, e.g.:
MLFLOW_TRACKING_URI=file:///home/z/my-project/ml/mlruns
# MLFLOW_TRACKING_URI=http://localhost:5000

# MLflow experiment + registered model name (evaluate.py --register)
MLFLOW_EXPERIMENT=roadguard-atlas
MLFLOW_REGISTERED_MODEL=roadguard-yolo

# Dataset root override for dataset/road_hazards.yaml `path` resolution
# ROADGUARD_DATA_ROOT=/absolute/path/to/datasets/road_hazards

# Inference service
MODEL_PATH=models/best.pt          # Ultralytics .pt weights (takes precedence)
ONNX_PATH=                         # e.g. models/roadguard.onnx — used if MODEL_PATH unset
DEVICE=cpu                         # cpu | cuda:0
CONF_THRESHOLD=0.25
IOU_NMS=0.45
MAX_IMAGE_SIDE=1280                # larger inputs are letterboxed down before inference
VIDEO_SAMPLE_FPS=2                 # ffmpeg sampling rate for POST /infer_video
VIDEO_MAX_FRAMES=300
MODEL_VERSION=                     # optional explicit version tag, else weights sha256[:12]
