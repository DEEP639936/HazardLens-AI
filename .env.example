# =============================================================================
# RoadGuard Atlas — environment contract (EXAMPLE — never commit real secrets)
#
# Copy to `.env` for docker compose (root) and fill values per environment.
# Platform secrets (Vercel/Render/Fly/Railway dashboards) mirror this file.
# Defaults below are LOCAL-ONLY placeholders used by docker-compose.yml.
# =============================================================================

# ---------------------------------------------------------------- Application
APP_ENV=development                      # development | staging | production
LOG_LEVEL=info                           # debug | info | warning | error

# ------------------------------------------------------------------ Frontend
# Vars prefixed NEXT_PUBLIC_ are embedded into the browser bundle — never put
# secrets in them.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000   # FastAPI base URL the SPA calls
NEXT_PUBLIC_APP_NAME=RoadGuard Atlas
NEXT_PUBLIC_MAP_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_SENTRY_DSN=                  # optional browser Sentry DSN (placeholder)
# Live-demo fallback for the Next.js app's own /api routes (Prisma/SQLite):
FRONTEND_DATABASE_URL=file:/app/db/custom.db

# ------------------------------------------------------------------- Database
# SQLAlchemy URI. Compose default: postgresql+psycopg://roadguard:roadguard@db:5432/roadguard
# Managed providers give postgresql://… — the backend normalizes to +psycopg.
DATABASE_URL=postgresql+psycopg://roadguard:roadguard@db:5432/roadguard
POSTGRES_PASSWORD=roadguard              # must match the db service password

# ----------------------------------------------------------------------- Auth
JWT_SECRET=change-me-min-32-chars-never-in-prod   # openssl rand -hex 32
JWT_ACCESS_TTL_MINUTES=15                # access token lifetime (brief: 15 min)
JWT_REFRESH_TTL_DAYS=30                  # refresh token lifetime (rotate on use)
#bcrypt cost is fixed at 10 in code (brief §4)

# ----------------------------------------------------------------------- CORS
CORS_ORIGINS=http://localhost:3000       # comma-separated allow-list for the API

# ---------------------------------------------------------------------- Redis
REDIS_URL=redis://redis:6379/0           # cache + rate limiting + celery broker

# -------------------------------------------------------------- Object storage
# STORAGE_BACKEND: local (UPLOAD_DIR) | s3 (S3_*: AWS/R2/MinIO/Supabase) | cloudinary (CLOUDINARY_URL)
STORAGE_BACKEND=local
UPLOAD_DIR=/app/uploads                  # local-mode media directory (volume)
S3_ENDPOINT=http://minio:9000            # R2: https://<acct>.r2.cloudflarestorage.com ; AWS: empty
S3_REGION=us-east-1                      # R2/MinIO: us-east-1 / auto
S3_BUCKET=roadguard-media
S3_ACCESS_KEY_ID=roadguard               # must equal MINIO_ROOT_USER in compose
S3_SECRET_ACCESS_KEY=roadguard-minio-secret  # must equal MINIO_ROOT_PASSWORD
S3_FORCE_PATH_STYLE=true                 # true for MinIO/Supabase, false for AWS/R2
CLOUDINARY_URL=                          # cloudinary://<api_key>:<api_secret>@<cloud_name>

# --------------------------------------------------------------- ML inference
INFERENCE_SERVICE_URL=http://ml-inference:8100   # YOLO/ONNX service consumed by api+worker
MODEL_PATH=/models/best.onnx             # exported weights path inside the ml container
INFERENCE_DEVICE=cpu                     # cpu | cuda

# --------------------------------------------------------------------- MLflow
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_SECRET_KEY=local-only-mlflow-secret       # MLFLOW_FLASK_SERVER_SECRET_KEY
MLFLOW_S3_ENDPOINT_URL=http://minio:9000         # artifacts via MinIO (boto3 reads these)
AWS_ACCESS_KEY_ID=roadguard                      # boto3 creds for MLflow artifacts
AWS_SECRET_ACCESS_KEY=roadguard-minio-secret

# ----------------------------------------------------------------------- MinIO
MINIO_ROOT_USER=roadguard
MINIO_ROOT_PASSWORD=roadguard-minio-secret       # min 8 chars; change locally

# ------------------------------------------------------------------ Monitoring
SENTRY_DSN=                              # backend/server Sentry DSN (placeholder — no telemetry when empty)

# --------------------------------------------------------------------- Celery
CELERY_APP=backend.app.celery_app.celery_app     # module:attr for `celery -A`
CELERY_LOG_LEVEL=INFO

# ----------------------------------------------------------- pgAdmin (optional)
# docker compose --profile tools up pgadmin  →  http://127.0.0.1:5050
PGADMIN_DEFAULT_EMAIL=admin@roadguardatlas.dev
PGADMIN_DEFAULT_PASSWORD=roadguard-pgadmin

# ------------------------------------------------------------------ CI/CD only
# Repo secrets (GitHub Settings → Secrets and variables → Actions):
#   DEPLOY_HOOK_URL   — POST endpoint triggered on v* tags (Render/Vercel/Railway hook)
#   (GITHUB_TOKEN is provided automatically for GHCR pushes)
# Sentry dsn placeholders belong here too: set SENTRY_DSN / NEXT_PUBLIC_SENTRY_DSN
# per platform — never commit real DSNs or keys to the repository.
